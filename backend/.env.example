# Copy to backend/.env (never commit .env). Every value is optional for local development:
# without them DOC runs with SQLite, local encrypted files, local email+password accounts and offline AI.

# ---------- Sign-in: Firebase Authentication (Google + email) ----------
# Firebase console > Project settings > General > Your apps > Web app config. These web values are public by design;
# the backend only uses FIREBASE_PROJECT_ID to verify ID tokens (no service-account key needed).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# ---------- Database: Supabase Postgres (+ pgvector) ----------
# Supabase > Connect > Session pooler (IPv4) URI. The API creates tables, the vector extension, match_chunks()
# and turns on deny-all row-level security on start-up (see backend/schema.sql).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- File storage: Supabase Storage (private bucket) ----------
# Service-role key = server only. The browser never talks to Supabase. Files are Fernet-encrypted before upload.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=health-files

# ---------- Secrets (auto-generated into backend/instance/ if empty; SET THEM in production) ----------
# JWT_SECRET=
# DOC_ENCRYPTION_KEY=   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---------- Optional AI boost (our own models work without these) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_PROVIDER=auto
AI_SEND_IMAGES=true
AI_VERIFY_ANSWERS=true
AI_RATE_PER_MIN=12

# ---------- Web ----------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # only if tesseract is not on PATH
