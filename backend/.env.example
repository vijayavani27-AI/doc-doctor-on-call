# Copy to backend/.env
# AI engines (report photos, handwriting, Hindi/Tamil, free-form chat). Leave both empty for offline mode.
# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Gemini (Google AI Studio key)
GEMINI_API_KEY=
# Comma-separated, tried in order (busy models fall through)
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite
# auto = Claude first if both keys are set; or force: claude / gemini
AI_PROVIDER=auto
AI_SEND_IMAGES=true
AI_VERIFY_ANSWERS=true

# Secrets: auto-generated into backend/instance/ if not set. Set explicitly in production.
# JWT_SECRET=
# CARETHREAD_ENCRYPTION_KEY=

# DATABASE_URL=postgresql+psycopg://user:pass@host/carethread
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
